# ─── Secrets / environment ────────────────────────────────────────────
# Never commit these — they hold the Supabase URL and anon key.
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ─── Dependencies ─────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Next.js build output ─────────────────────────────────────────────
.next/
out/
build/
dist/

# ─── TypeScript ───────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing / coverage ───────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Caches ───────────────────────────────────────────────────────────
.turbo/
.cache/
.eslintcache
.swc/

# ─── Vercel ───────────────────────────────────────────────────────────
.vercel

# ─── Supabase local dev ───────────────────────────────────────────────
# Keep schema.sql and migrations/ — they are source. Ignore local runtime state.
supabase/.branches/
supabase/.temp/
supabase/.env

# ─── Editor / OS ──────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Tooling local state ──────────────────────────────────────────────
.claude/settings.local.json
